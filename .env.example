# GG-Core - configuration.
# You do NOT need to copy this file: the first `make` creates .env with RANDOM secrets (infra/gen-secrets.sh) and
# never overwrites an existing value. Listed here for reference. `make admin` shows the login URL and admin password.

# Generated automatically (random) - keep them secret
JWT_SECRET=              # signs the login sessions
GG_ADMIN_TOKEN=          # scripts / curl: "Authorization: Bearer <token>"
GG_ADMIN_PASSWORD=       # offline admin login on /login (works without Internet)
GG_LOGS_TOKEN=           # CS2 -> agent log ingestion (logaddress_add_http …?token=…)
GG_RCON_PASSWORD=        # RCON of the CS2 servers

# To fill in
GG_ADMIN_STEAMIDS=       # SteamID64 of the admins, comma separated (Sign in through Steam)
GG_ENV=                 # mode: dev | rec | prod (prod when empty or unknown). dev: every tool open; rec: acceptance test, no !init / no authentication switch-off, strict validation; prod: also no Sandbox, no /api/docs. The dev compose sets dev
GG_API_DOCS=             # 0 = close the API documentation (/api/docs, admins only) in dev and rec; it is open there by default and never in prod
GG_VALIDATION=           # inputs of the routes with a described class: tolerant (logs what it would refuse; the default in dev), strict (400; the default in rec and prod), off

# Optional
AUTH_PUBLIC_URL=         # public URL of the backend if Steam must send browsers back elsewhere (tunnel…)
AUTH_DISABLED=           # 1 = no authentication (throwaway dev setup only): refused outside GG_ENV=dev, the backend does not start
