{
  "name": "ggbot-backend",
  "version": "1.0.0",
  "description": "Backend NestJS pour GGBot (gestion logs CS2 + Redis + WebSocket)",
  "author": "Maxime Yonnet",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "openapi:export": "nest build && node dist/tools/export-openapi.cli.js",
    "openapi:check": "nest build && node dist/tools/export-openapi.cli.js && node dist/tools/check-openapi-completeness.cli.js",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "postbuild": "tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "check": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/websockets": "^10.4.20",
    "@picocss/pico": "^2.1.1",
    "@prisma/client": "^6.19.3",
    "body-parser": "^2.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.2",
    "express": "^4.22.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.2.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "multer": "$multer",
    "express": {
      "qs": "6.14.3"
    }
  }
}
